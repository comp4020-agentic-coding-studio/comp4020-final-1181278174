---
import type { QuestionView, State } from "../lib/board.ts";
import { UNDO_MS } from "../lib/actions.ts";
import { ago, votesLabel } from "../lib/words.ts";
import Icon from "./Icon.astro";

// One question as one person sees it. The session page uses it for every
// question in the list, and once more inside a <template>, which the page's
// script copies to draw a question that arrives while the page is open.
type Props = { q: QuestionView; hosting: boolean };
const { q, hosting } = Astro.props;
const signedIn = Astro.locals.account !== null;
// a report can be taken back for a minute; the Undo button hides itself when the minute is up
const undoLeft = q.reportedAt === null ? 0 : Math.max(0, UNDO_MS - (Date.now() - q.reportedAt));

// what the host can do to a question in each state
const hostButtons: Record<State, [to: State, label: string][]> = {
  open: [
    ["answered", "Answered"],
    ["hidden", "Hide"],
  ],
  answered: [
    ["open", "Not answered"],
    ["hidden", "Hide"],
  ],
  hidden: [["open", "Show again"]],
};
---

<li id={`q-${q.id}`} data-state={q.state}>
  <p class="body">{q.body}</p>
  <div class="q-foot">
    <p class="meta">
      {/* HTML compression drops the whitespace between tags; the spaces are
          explicit so the text doesn't read "Yoursjust now" */}
      {q.state === "answered" && <span class="tag">Answered</span>}
      {q.state === "hidden" && <span class="tag">Hidden</span>}
      {" "}
      {q.yours && <span class="yours">Yours</span>}
      {" "}
      {/* the page's script keeps this up to date from the datetime */}
      <time datetime={q.createdAt.toISOString()}>{ago(q.createdAt)}</time>
    </p>
    {signedIn ? (
      <div class="q-actions">
        <form method="post" class="vote">
          <input type="hidden" name="intent" value="vote" />
          <input type="hidden" name="question" value={q.id} />
          <button
            class="me-too"
            type="submit"
            name="want"
            value={q.voted ? "0" : "1"}
            aria-pressed={q.voted ? "true" : "false"}
            aria-label={votesLabel(q.votes)}
          >
            <Icon name="hand" size={18} />
            <span>Me too</span>
            {" "}
            <span class="n">{q.votes}</span>
          </button>
        </form>
        {!hosting && !q.yours && (
          q.reportedAt === null ? (
            // a small triangle; pressing it asks once more before anything is sent
            <details class="report" data-report>
              <summary class="report-flag" aria-label="Report this question to the host" title="Report this question to the host">
                <Icon name="alert" size={16} />
              </summary>
              <form method="post" class="report-confirm">
                <input type="hidden" name="intent" value="report" />
                <input type="hidden" name="question" value={q.id} />
                <span>Report to the host?</span>{" "}
                <button class="report-yes" type="submit">Report</button>
              </form>
            </details>
          ) : (
            // reported: the triangle filled, and for a minute a way to take it back
            <div class="report reported" data-report>
              <span class="report-flag is-on" role="img" aria-label="You reported this question" title="You reported this question">
                <Icon name="alert" size={16} />
              </span>
              {undoLeft > 0 && (
                <form method="post" class="report-undo" style={`--undo-left: ${undoLeft}ms`}>
                  <input type="hidden" name="intent" value="unreport" />
                  <input type="hidden" name="question" value={q.id} />
                  <button type="submit">Undo</button>
                </form>
              )}
            </div>
          )
        )}
      </div>
    ) : (
      <span class="me-too" aria-label={votesLabel(q.votes)}>
        <Icon name="hand" size={18} />
        <span>Me too</span>{" "}<span class="n">{q.votes}</span>
      </span>
    )}
  </div>
  {
    signedIn && hosting && (
      <form method="post" class="host">
        <input type="hidden" name="intent" value="state" />
        <input type="hidden" name="question" value={q.id} />
        {q.state === "hidden" && <span class="host-note">Only you can see this.</span>}
        {q.reports > 0 && (
          <span class="report-count" role="img" aria-label={`Reported ${q.reports} ${q.reports === 1 ? "time" : "times"}`} title={`Reported ${q.reports} ${q.reports === 1 ? "time" : "times"}`}>
            <Icon name="alert" size={14} />{q.reports}
          </span>
        )}
        {hostButtons[q.state].map(([to, label]) => (
          <button class="host-button" type="submit" name="to" value={to}>
            {label}
          </button>
        ))}
      </form>
    )
  }
</li>
