---
import "../styles.css";
import AccountMenu from "../components/AccountMenu.astro";

// `account` false leaves out "Signed in as ...": the projector is on a big screen.
// `footer` false leaves out the links at the foot, for the same reason.
type Props = { title: string; sunny?: boolean; account?: boolean; footer?: boolean };
const { title, sunny = false, account = true, footer = true } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="An anonymous question board for one room." />
    <meta name="theme-color" content="#ffd43b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class={sunny ? "sunny" : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    {account && <header class="account-header"><div class="wrap"><AccountMenu /></div></header>}
    <slot />
    {
      footer && (
        <footer class="site-footer">
          <nav class="wrap" aria-label="About this app">
            <a href="/help">How it works</a>
            <a href="/privacy">Privacy and rules</a>
            <a href="/readme/">About</a>
          </nav>
        </footer>
      )
    }
  </body>
</html>
