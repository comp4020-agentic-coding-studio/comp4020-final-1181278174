---
import "../styles.css";
import AccountMenu from "../components/AccountMenu.astro";

// `account` false leaves out "Signed in as ...": the projector is on a big screen.
// `footer` false leaves out the links at the foot, for the same reason.
type Props = { title: string; sunny?: boolean; account?: boolean; footer?: boolean };
const { title, sunny = false, account = true, footer = true } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Lost in a lecture? Put your hand up with one press and see how many others are lost too." />
    <meta name="theme-color" content="#f5f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#13231e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/instrumentsans/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bricolagegrotesque/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class={sunny ? "sunny" : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    {/* not a header: the page's own header is its one banner; the menu is a labelled nav */}
    {account && <div class="account-header"><div class="wrap"><AccountMenu /></div></div>}
    <slot />
    {
      footer && (
        <footer class="site-footer">
          <nav class="wrap" aria-label="About this app">
            <a href="/help">How it works</a>
            <a href="/privacy">Privacy and rules</a>
            <a href="/readme/">About</a>
          </nav>
        </footer>
      )
    }
  </body>
</html>
