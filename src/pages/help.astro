---
// How it works: what a student and a host do, and what no one is shown.
// Drawn on the design canvas first ("How it works · phone", 9 November).
import SlimHeader from "../components/SlimHeader.astro";
import Guide from "../components/Guide.astro";
import Layout from "../layouts/Layout.astro";
import { GOING_OVER_MS, HAND_MS } from "../lib/hall.ts";
import { guideDone, handleGuide } from "../lib/guide.ts";

const minutes = (ms: number): string => `${Math.round(ms / 60_000)} minutes`;
const selected = Astro.url.searchParams.get("guide");
const guideRole = selected === "student" || selected === "host" ? selected : null;
const context = { account: Astro.locals.account, cookies: Astro.cookies, url: Astro.url, log: Astro.locals.log };
let problem = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("intent") !== "guide" || !guideRole) {
    Astro.response.status = 422;
    problem = "Choose the student or host guide below.";
    Astro.locals.log("refused", { action: "guide", reason: "no-such-guide" });
  } else {
    const done = handleGuide(form, context, guideRole);
    if (done.ok) {
      // Reset keeps the preview open; finishing returns to this help page.
      return Astro.redirect(form.get("guide_action") === "reset" ? Astro.url.pathname + Astro.url.search + "#guide" : "/help", 303);
    }
    Astro.response.status = done.status;
    problem = done.message;
  }
}
---

<Layout title="How it works · Hands Up">
  <SlimHeader />
  <main id="main" class="wrap info">
    <h1>How it works</h1>
    <p class="lead">One room, one code. A hand needs no words, and the whole room sees how many are up.</p>
    {problem && <p class="alert" role="alert">{problem}</p>}
    <nav class="guide-links" aria-label="First-visit guides">
      <a href="/help?guide=student#guide">Show the guide again</a>
      <a href="/help?guide=host#guide">Show the host guide again</a>
    </nav>
    {guideRole && <>
      <Guide role={guideRole} replay />
      {!guideDone(context, guideRole) && <p class="notice" role="status">This guide will show next time you open the hall.</p>}
    </>}

    <section class="card panel" aria-labelledby="in-the-room">
      <h2 id="in-the-room">In the room</h2>
      <ol>
        <li>Join with the code or the QR code on the screen at the front.</li>
        <li>Anyone can look. To take part, <a href="/signup">create an account</a>: a username and a password, nothing else.</li>
        <li>Lost? Press <strong>I'm lost</strong>. No words. Your hand comes down by itself after {minutes(HAND_MS)}. Hands can go up while the host's class is on.</li>
        <li>The hall and the projector show how many of the people counted here say they're lost, never whose hand it is. Counted are those signed in with the session open or with a hand still up; the host and the projector aren't.</li>
        <li>Ask a question without your name, or press <strong>Me too</strong> on one you share.</li>
        <li>A question that shouldn't be there? Open the small triangle and press <strong>Report</strong>. The host sees how many reported it.</li>
        <li>Pages change by themselves as the room does. Without JavaScript, reload to see changes.</li>
      </ol>
    </section>

    <section class="card panel" aria-labelledby="teaching">
      <h2 id="teaching">Teaching</h2>
      <ol>
        <li>Start a session and put its projector page up.</li>
        <li>Press <strong>Start class</strong> when you begin: hands can go up until you press <strong>End class</strong>, which takes every hand down. Next week, start the same code again; the timeline shows when each class started and ended.</li>
        <li>You teach: you have no hand, and you aren't counted.</li>
        <li><strong>At your next pause</strong> keeps the part so far: its minute with the most hands up, and the most wanted question. Look at it when you pause; you don't need to watch the count.</li>
        <li><strong>Going over it</strong> shows a message on the hall, the questions, the projector and the floating window, for {minutes(GOING_OVER_MS)}.</li>
        <li>Mark the parts of the lecture and when the recording started. The timeline keeps how many of those counted said they were lost, minute by minute, so you can find the moment in the recording.</li>
        <li><strong>Pop out</strong> keeps the count in a small window over your slides, in browsers that can open one. Keep the hall tab open: closing it closes the window.</li>
        <li>Hide a question, or mark it answered. You see how many reported it, not who.</li>
      </ol>
    </section>

    <section class="card panel info-sun" aria-labelledby="shown">
      <h2 id="shown">What the app shows</h2>
      <p>The app shows no one else which account raised a hand, asked, pressed Me too or reported: not the host, not other students. In a small room, a count can still show whose hand is up.</p>
      <a class="go" href="/privacy">What is kept, and who can see it</a>
    </section>
  </main>
</Layout>

<style>
  .guide-links { display: flex; flex-wrap: wrap; gap: 0 20px; }
  .guide-links a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
</style>
