---
import Icon from "../components/Icon.astro";
import JoinForm from "../components/JoinForm.astro";
import Layout from "../layouts/Layout.astro";
import { checkTitle, length, MAX_TITLE, sessionsHostedBy, startSession } from "../lib/board.ts";
import { clock, day } from "../lib/words.ts";
import { authLink } from "../lib/auth.ts";

// Starting a session posts back here: on success it goes to the new
// session, otherwise this page comes back with the name kept and the reason.
let title = "";
let problem: string | undefined;
const signedOut = !Astro.locals.account;
const signin = authLink("signin", Astro.url.pathname + Astro.url.search);
const signup = authLink("signup", Astro.url.pathname + Astro.url.search);
if (Astro.request.method === "POST" && signedOut) {
  Astro.response.status = 401;
  problem = "Sign in to do that.";
  Astro.locals.log("refused", { action: "start", reason: "signed-out" });
} else if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  title = String(form.get("title") ?? "").trim();
  problem = checkTitle(title);
  if (!problem) {
    const code = startSession(title, Astro.locals.person);
    Astro.locals.log("session_started", { session: code });
    return Astro.redirect(`/s/${code}`, 303);
  }
  Astro.response.status = 422;
  const reason = title.length === 0 ? "empty" : "too-long";
  Astro.locals.log("refused", { action: "start", reason, length: length(title) });
}

// The account's sessions are available in every signed-in browser.
const hosted = Astro.locals.account ? sessionsHostedBy(Astro.locals.person) : [];
---

<Layout title="Hands Up" sunny>
  <main id="main" class="wrap home-layout">
    <div class="hero">
      <span class="hero-mark"><Icon name="hand" size={36} /></span>
      <h1>Hands Up</h1>
      <p>Lost in a lecture? Put your hand up with one press and see how many others are lost too. No one, the lecturer included, is shown whose hand is up.</p>
      <svg class="hero-room" width="432" height="172" viewBox="0 0 432 172" fill="none" aria-hidden="true" focusable="false">
        <path class="room-row" d="M20 80Q216 224 412 80M50 55Q216 177 382 55M83 30Q216 127 349 30" />
        <g class="room-seat">
          <rect x="69" y="100" width="27" height="23" rx="7" transform="rotate(28 82 111)" />
          <rect x="132" y="130" width="27" height="23" rx="7" transform="rotate(14 145 141)" />
          <rect x="202" y="141" width="27" height="23" rx="7" />
          <rect x="272" y="130" width="27" height="23" rx="7" transform="rotate(-14 285 141)" />
          <rect x="335" y="100" width="27" height="23" rx="7" transform="rotate(-28 348 111)" />
          <rect x="111" y="69" width="27" height="23" rx="7" transform="rotate(22 124 80)" />
          <rect x="171" y="90" width="27" height="23" rx="7" transform="rotate(7 184 101)" />
          <rect x="232" y="90" width="27" height="23" rx="7" transform="rotate(-7 245 101)" />
          <rect x="292" y="69" width="27" height="23" rx="7" transform="rotate(-22 305 80)" />
          <rect x="143" y="37" width="27" height="23" rx="7" transform="rotate(18 156 48)" />
          <rect x="202" y="49" width="27" height="23" rx="7" />
          <rect x="261" y="37" width="27" height="23" rx="7" transform="rotate(-18 274 48)" />
        </g>
        <rect class="room-seat-you" x="202" y="141" width="27" height="23" rx="7" />
      </svg>
    </div>

    <div class="stack">
      <section class="card panel join-panel" aria-labelledby="join-heading">
        <h2 id="join-heading">Join a session</h2>
        <p>Type the code on the screen at the front of the room.</p>
        <JoinForm />
        <a class="go" href="/s/HAND">Try the open hall: HAND <Icon name="arrow" size={16} /></a>
      </section>

      <section class="card quiet panel" aria-labelledby="start-heading">
        <h2 id="start-heading">Start a session</h2>
        {problem && <p class="alert" role="alert">{problem}{signedOut && <> <a href={signin}>Sign in</a></>}</p>}
        {signedOut ? (
          <p>Sign in to start a session. <a href={signin}>Sign in</a>{" or "}<a href={signup}>Create account</a>.</p>
        ) : (
          <form method="post" class="panel">
            <label for="title">Name it</label>
            <input
              class="title-input"
              id="title"
              name="title"
              type="text"
              maxlength={MAX_TITLE}
              required
              placeholder="COMP4020 week 9 lecture"
              value={title}
            />
            <button class="button ink" type="submit">Start a session</button>
          </form>
        )}
      </section>

      {hosted.length > 0 && (
        <section class="card quiet panel hosted" aria-labelledby="hosted-heading">
          <h2 id="hosted-heading">Sessions you started</h2>
          <ul class="hosted-list" aria-label="Sessions you started">
            {hosted.map((h) => (
              <li>
                <p class="hosted-title">{h.title}</p>
                <p class="hint">
                  {day(h.createdAt)}, {clock(h.createdAt)} · Code {h.code}
                </p>
                <p class="hosted-links">
                  <a href={`/s/${h.code}`}>Hall</a>
                  <a href={`/s/${h.code}/timeline`}>When the room was lost</a>
                </p>
              </li>
            ))}
          </ul>
          <p class="hint">Sign in on any device to find your sessions here.</p>
        </section>
      )}

      <p class="foot"><a href="/readme/">About Hands Up</a> <span>Your username stays private.</span></p>
    </div>
  </main>
</Layout>
