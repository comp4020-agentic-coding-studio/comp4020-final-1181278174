---
import Card from "../../components/Card.astro";
import ReportedNotice from "../../components/ReportedNotice.astro";
import GoingOver from "../../components/GoingOver.astro";
import Guide from "../../components/Guide.astro";
import Icon from "../../components/Icon.astro";
import JoinForm from "../../components/JoinForm.astro";
import SessionBand from "../../components/SessionBand.astro";
import SessionTabs from "../../components/SessionTabs.astro";
import SlimHeader from "../../components/SlimHeader.astro";
import Layout from "../../layouts/Layout.astro";
import { endClass, goingOver, mark, report, startClass, timelineMark, unreport, vote } from "../../lib/actions.ts";
import { authLink } from "../../lib/auth.ts";
import { accountRefusal } from "../../lib/abuse.ts";
import { findSession, isCode, isHost, listQuestions, normaliseCode, raiseHand } from "../../lib/board.ts";
import { classState, latestClass } from "../../lib/classes.ts";
import { HAND_MS } from "../../lib/hall.ts";
import { goingOverAge } from "../../lib/going-over.ts";
import { guideDone, handleGuide } from "../../lib/guide.ts";
import { people } from "../../lib/live.ts";
import { MAX_MARK, marksOf, partSoFar, recentLost } from "../../lib/record.ts";
import { handOf, handsUp } from "../../lib/room.ts";
import { classNote, clock, GOING_OVER_NOTE, handNote, lostLabel, moment, refusal, SILENCE, SILENCE_SHORT, tooFast } from "../../lib/words.ts";

// The hall, the first part of a session: "I'm lost", and how many of the
// people here have pressed it. Under it, the three open questions the room
// wants answered most, which take "Me too" here too. The questions page,
// /s/CODE/questions, is the second part.
const raw = Astro.params.code ?? "";
const code = normaliseCode(raw);
if (Astro.request.method === "GET" && code !== raw && isCode(code)) {
  return Astro.redirect(`/s/${code}${Astro.url.search}`, 301);
}
const session = isCode(code) ? findSession(code) : undefined;
const person = Astro.locals.person;
const signedIn = Astro.locals.account !== null;
const returnTo = Astro.url.pathname + Astro.url.search;
const log = Astro.locals.log;
const hosting = signedIn && session !== undefined && isHost(session, person);
const guideRole = hosting ? "host" : "student";
const guideContext = { account: Astro.locals.account, cookies: Astro.cookies, url: Astro.url, log };
let goingOverProblem = "";
// a refused press comes back saying why; a refused mark keeps its words
let problem = "";
let markValue = "";
let markProblem = "";
const form = Astro.request.method === "POST" ? await Astro.request.formData() : undefined;
const intent = form?.get("intent");
const signedOutPost = session && form && !signedIn && intent !== "guide";

if (form && intent === "guide") {
  if (session) {
    const done = handleGuide(form, guideContext, guideRole);
    if (done.ok) return Astro.redirect(returnTo, 303);
    Astro.response.status = done.status;
    problem = done.message;
  } else {
    log("refused", { action: "guide", reason: "session-not-found" });
  }
} else if (signedOutPost) {
  Astro.response.status = 401;
  log("refused", { session: session.code, reason: "signed-out" });
} else if (session && form) {
  if (intent === "hand" && isHost(session, person)) {
    // the host teaches and has no hand: a press sent by hand is refused, so no host hand reaches a count or the record
    Astro.response.status = 403;
    problem = refusal("hand", 403);
    log("refused", { action: "hand", session: session.code, reason: "host" });
  } else if (intent === "hand") {
    // "I'm lost": one press, no words. Like a vote, it sends up (1) or down (0).
    const up = form.get("up");
    const lesson = classState(session);
    if (up === "1" && lesson !== "on") {
      // a hand goes up only while the class is on; coming down is always fine
      Astro.response.status = 422;
      problem = classNote(lesson);
      log("refused", { action: "hand", session: session.code, reason: lesson === "before" ? "class-not-started" : "class-ended" });
    } else if (up === "1" || up === "0") {
      const limited = accountRefusal(person, "hand", log, session.code);
      if (limited) {
        Astro.response.status = limited.status;
        Astro.response.headers.set("Retry-After", String(limited.retryAfter));
        problem = tooFast(limited.retryAfter);
      } else {
        const done = raiseHand(session, person, up === "1");
        log(done === "unchanged" ? "hand_unchanged" : `hand_${done}`, { session: session.code });
        return Astro.redirect(`/s/${session.code}#hall`, 303);
      }
    } else {
      Astro.response.status = 422;
      problem = refusal("hand", 422);
      log("refused", { action: "hand", session: session.code, reason: "no-such-value" });
    }
  } else if (intent === "class-start" || intent === "class-end") {
    // the host starts or ends the class (src/lib/actions.ts)
    const done = (intent === "class-start" ? startClass : endClass)(session, person, log);
    if (done.ok) return Astro.redirect(`/s/${session.code}#host`, 303);
    Astro.response.status = done.status;
    if (done.retryAfter) Astro.response.headers.set("Retry-After", String(done.retryAfter));
    problem = done.status === 429 ? tooFast(done.retryAfter) : refusal(intent, done.status);
  } else if (intent === "vote" || intent === "report" || intent === "unreport") {
    const done = (intent === "vote" ? vote : intent === "report" ? report : unreport)(session, person, form, log);
    if (done.ok) return Astro.redirect(`/s/${session.code}#q-${done.question}`, 303);
    Astro.response.status = done.status;
    if (done.retryAfter) Astro.response.headers.set("Retry-After", String(done.retryAfter));
    problem = done.status === 429 ? tooFast(done.retryAfter) : refusal(intent, done.status);
  } else if (intent === "going-over") {
    const done = goingOver(session, person, log);
    if (done.ok) return Astro.redirect(`/s/${session.code}#host`, 303);
    Astro.response.status = done.status;
    if (done.retryAfter) Astro.response.headers.set("Retry-After", String(done.retryAfter));
    goingOverProblem = done.status === 429 ? tooFast(done.retryAfter) : "Only the host can say they are going over it.";
  } else if (intent === "timeline_mark") {
    const done = timelineMark(session, person, form, log);
    // back to the host's controls, saying which mark it was: the newest is last
    if (done.ok) return Astro.redirect(`/s/${session.code}?marked=${marksOf(session.id).length}#host`, 303);
    Astro.response.status = done.status;
    if (done.retryAfter) Astro.response.headers.set("Retry-After", String(done.retryAfter));
    markValue = String(form.get("label") ?? "");
    markProblem = done.status === 429 ? tooFast(done.retryAfter) : done.status === 422 ? `Use at most ${MAX_MARK} characters for a mark.` : refusal("timeline_mark", done.status);
    if (done.status !== 422) problem = markProblem;
  } else if (intent === "state") {
    // the host's Answered and Hide, on the three most wanted
    const done = mark(session, person, form, log);
    if (done.ok) return Astro.redirect(`/s/${session.code}#q-${done.question}`, 303);
    Astro.response.status = done.status;
    if (done.retryAfter) Astro.response.headers.set("Retry-After", String(done.retryAfter));
    problem = done.status === 429 ? tooFast(done.retryAfter) : refusal("state", done.status);
  } else {
    Astro.response.status = 400;
    problem = refusal("", 400);
    log("refused", { session: session.code, reason: "no-such-intent" });
  }
}
if (!session) Astro.response.status = 404;

const guideComplete = guideDone(guideContext, guideRole);
const all = session ? listQuestions(session, signedIn ? person : "", "popular") : [];
const listed = all.filter((q) => q.state !== "hidden").length;
const wanted = all.filter((q) => q.state === "open").slice(0, 3);
const parts = session && hosting ? marksOf(session.id) : [];
// for the host's next pause: the part so far, while a class is on
const checkpoint = session && hosting ? partSoFar(session.id, people(session.id).size) : null;
// the mark the host has just made, said back to them under the form
const marked = Astro.request.method === "GET" ? parts[Number(Astro.url.searchParams.get("marked")) - 1] : undefined;

// The hall as this person is about to see it: everyone with the session open,
// and this signed-in person, who will be once the page's stream opens, unless
// they are the host, who teaches and is not counted. How long their own hand has been
// up is put in their page, never in what the stream sends.
const inRoom = session ? [...new Set([...people(session.id), ...(signedIn && !hosting ? [person] : [])])] : [];
const mine = session && signedIn ? handOf(session.id, person) : undefined;
// and when the session started and its last 16 minutes, for the small window's chart
const room = {
  here: inRoom.length,
  hands: session ? handsUp(session.id, inRoom) : [],
  mine: mine ?? null,
  recent: session ? recentLost(session.id, 16) : [],
  startedAt: session?.createdAt.getTime(),
};
const until = mine === undefined ? undefined : new Date(Date.now() + HAND_MS - mine);
// before the host starts the class, on, or over: hands go up only while it is on
const classNow = session ? classState(session) : "on";
const lastClass = session ? latestClass(session.id) : undefined;
---

{
  session ? (
    <Layout title={`${session.title} · Hands Up`}>
      <SessionBand code={session.code} title={session.title} hosting={hosting} guideComplete={guideComplete}>
        <SessionTabs code={session.code} at="hall" count={listed} />
      </SessionBand>

      <main id="main" class="wrap hall-layout" data-live={`/s/${session.code}/events`}>
        <section class="card hall" id="hall" aria-labelledby="hall-count">
          {signedOutPost && (
            <p class="alert" role="alert">Sign in to do that. <a href={authLink("signin", returnTo)}>Sign in</a></p>
          )}
          {problem && <p class="alert" role="alert">{problem}</p>}
          {/* the hall is drawn here by src/scripts/hall.ts; the sentence under it says the same in words */}
          <div class="hall-view" data-hall data-view={hosting ? "front" : "seat"} aria-hidden="true" />
          <div class="hall-meta">
            {!guideComplete && <p class="hint hall-caption">Seats and hands are placed at random on each screen.</p>}
            {/* shown by the page's script once its stream is open */}
            <p class="live" role="status" data-live-status hidden />
          </div>
          <p class="hall-count" id="hall-count" aria-live="polite" data-lost data-host={hosting ? "" : undefined} data-room={JSON.stringify(room)}>
            {hosting && room.here === 0 ? "Waiting for students to join." : lostLabel(room.hands.length, room.here)}
          </p>
          {hosting && session.code !== "HAND" && (
            <form method="post" class="hall-class" data-plain>
              <input type="hidden" name="intent" value={classNow === "on" ? "class-end" : "class-start"} />
              <button class={classNow === "on" ? "button" : "button ink"} type="submit" aria-describedby="class-note">
                {classNow === "on" ? "End class" : "Start class"}
              </button>
              <p class="hint" id="class-note">
                {classNow === "on" && lastClass
                  ? `Class started at ${moment(lastClass.startedAt)}. Hands are open.`
                  : classNow === "over" && lastClass?.endedAt
                    ? `Class ended at ${moment(lastClass.endedAt)}. All hands are down.`
                    : "Hands open when you start the class."}
              </p>
            </form>
          )}
          {hosting && (
            <a class="button ink hall-projector" href={`/s/${session.code}/present`}>Open projector page</a>
          )}
          <GoingOver age={goingOverAge(session.id)} />
          <p class="hint hall-silence" data-silence hidden={room.hands.length > 0 || (hosting && room.here === 0)}>
            {hosting || guideComplete ? SILENCE_SHORT : SILENCE}
          </p>
          <p class="hint">
            <Icon name="lock" size={14} /> No one, the host included, is shown whose hand is up.
          </p>
          {signedIn && !hosting && (
            <form method="post" class="hall-hand" data-hand data-class={classNow} data-class-before={classNote("before")} data-class-over={classNote("over")}>
              <input type="hidden" name="intent" value="hand" />
              <input type="hidden" name="up" value={mine === undefined ? "1" : "0"} />
              <button class="button tomato lost-button" type="submit" aria-pressed={mine === undefined ? "false" : "true"} aria-describedby="hand-note" disabled={classNow !== "on" && mine === undefined}>
                <Icon name="hand" size={22} /> I'm lost
              </button>
              <p class="hint hand-note" id="hand-note" data-hand-note aria-live="polite">
                {classNow !== "on" && mine === undefined ? classNote(classNow) : handNote(until)}
              </p>
            </form>
          )}
          {!signedIn && (
            <div class="hall-hand auth-prompt">
              <a class="button tomato" href={authLink("signin", returnTo)}>
                <Icon name="hand" size={22} /> Sign in to raise your hand
              </a>
              <p class="hint">
                No account? <a href={authLink("signup", returnTo)}>Create one</a>: just a username and password.
              </p>
            </div>
          )}
          <div class="hall-links">
            <a href={`/s/${session.code}/timeline`}>When the room was lost</a>
            {/* shown by src/scripts/float.ts where the browser can keep a small window above the others */}
            <div class="pop-control" hidden>
              <button class="button pop" type="button" data-pop="hall" aria-describedby="hall-pop-note" hidden>
                <Icon name="pop" size={16} /> Pop out
              </button>
              <p class="hint pop-note" id="hall-pop-note">Keep this tab open; you can switch to your slides.</p>
            </div>
          </div>
          {!hosting && !guideComplete && <Guide role="student" />}
        </section>

        {hosting && (
          <section class="card host-panel hall-host" id="host" aria-labelledby="host-title">
            <h2 id="host-title">For the host</h2>
            {!guideComplete && <p class="hint host-note">You teach: you have no hand here, and you aren't counted.</p>}
            {/* refreshed by src/scripts/checkpoint.ts as the room changes; copied into the host's floating window */}
            <section class="checkpoint" aria-labelledby="checkpoint-title" data-checkpoint hidden={!checkpoint}>
              <h3 id="checkpoint-title">At your next pause</h3>
              {checkpoint && (
                <>
                  <p class="hint checkpoint-part">
                    {checkpoint.label ? `${checkpoint.label}, since ${clock(checkpoint.from)}.` : `Since the class started at ${clock(checkpoint.from)}.`}
                  </p>
                  <p class="checkpoint-most">
                    {checkpoint.most
                      ? `At ${clock(checkpoint.most.at)}, ${checkpoint.most.lost} of ${checkpoint.most.here} here said they were lost: the most in this part.`
                      : `No one has said they were lost in this part. ${SILENCE_SHORT}`}
                  </p>
                  {wanted[0] && (
                    <p class="checkpoint-question">
                      Most wanted:{" "}
                      <a href={`/s/${session.code}/questions#q-${wanted[0].id}`}>“{wanted[0].body}”</a>{" "}
                      · {wanted[0].votes} Me too
                    </p>
                  )}
                </>
              )}
            </section>
            {goingOverProblem && <p class="alert" role="alert">{goingOverProblem}</p>}
            <form method="post" class="hall-going-over" data-going-over-form data-plain>
              <input type="hidden" name="intent" value="going-over" />
              <button class="button ink" type="submit" aria-describedby={guideComplete ? undefined : "going-over-note"}>Going over it</button>
              {!guideComplete && <p class="hint" id="going-over-note">{GOING_OVER_NOTE}</p>}
              <p class="alert" role="status" data-going-over-problem hidden />
            </form>
            <form method="post" class="hall-mark" data-plain>
              <input type="hidden" name="intent" value="timeline_mark" />
              <label for="mark-label">Mark a new part</label>
              <div class="host-row">
                <input id="mark-label" name="label" type="text" maxlength={MAX_MARK} placeholder={`Part ${parts.length + 1}`} value={markValue} aria-describedby={markProblem ? "mark-problem" : undefined} />
                <button class="button ink" type="submit">
                  Mark
                </button>
              </div>
              {markProblem && markValue && (
                <p class="alert" role="alert" id="mark-problem">
                  {markProblem}
                </p>
              )}
              {marked && (
                <p class="hint host-marked" role="status">
                  Marked “{marked.label}” at {clock(marked.at)}.{" "}
                  <a href={`/s/${session.code}/timeline`}>See it on the timeline</a>
                </p>
              )}
            </form>
            {!guideComplete && <Guide role="host" />}
          </section>
        )}

        <section class="wanted" aria-labelledby="wanted-title">
          <div class="bar">
            <h2 id="wanted-title">Most wanted</h2>
            <div class="bar-end">
              <a class="count-label" href={`/s/${session.code}/questions`}>
                All questions
              </a>
            </div>
          </div>
          {/* the three most wanted, fetched again from the server when the questions change */}
          <div data-board data-refresh data-sort="popular">
            <ReportedNotice list={all} hosting={hosting} link={(id) => `/s/${session.code}/questions#q-${id}`} />
            <p class="card empty" data-empty hidden={wanted.length > 0}>
              <Icon name="hand" size={22} /> {listed > 0 ? "No open questions." : "No questions yet."}{" "}
              <a href={`/s/${session.code}/questions`}>{listed > 0 ? "Ask the next one." : "Ask the first one."}</a>
            </p>
            <ol aria-label="Most wanted" class="questions">
              {wanted.map((q) => (
                <Card q={q} hosting={hosting} reportable={session.host !== null} />
              ))}
            </ol>
          </div>
        </section>

        {!hosting && (
          <p class="foot session-foot">
            <a href={`/s/${session.code}/present`}>Projector page</a>{!guideComplete && <> <span>For the screen at the front.</span></>}
          </p>
        )}
      </main>
      <script>
        import "../../scripts/live.ts";
        import "../../scripts/hand.ts";
        import "../../scripts/float.ts";
        import "../../scripts/checkpoint.ts";
        // three.js is big: the button works before it arrives
        void import("../../scripts/hall.ts");
      </script>
    </Layout>
  ) : (
    <Layout title="No such session · Hands Up">
      <SlimHeader />
      <main id="main" class="wrap lost">
        <div class="card panel">
          <h1>No session with the code {code}</h1>
          <p>Check the code on the screen at the front of the room, and try again.</p>
          <JoinForm value={raw} />
        </div>
      </main>
    </Layout>
  )
}

<style>
  .hall-projector {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
</style>
