---
import Icon from "../../../components/Icon.astro";
import GoingOver from "../../../components/GoingOver.astro";
import JoinForm from "../../../components/JoinForm.astro";
import SlimHeader from "../../../components/SlimHeader.astro";
import Layout from "../../../layouts/Layout.astro";
import { findSession, isCode, listQuestions, normaliseCode } from "../../../lib/board.ts";
import { people } from "../../../lib/live.ts";
import { goingOverAge } from "../../../lib/going-over.ts";
import { handsUp } from "../../../lib/room.ts";
import { howMany, lostLabel, SILENCE_SHORT } from "../../../lib/words.ts";
import { renderSVG } from "uqr";

// The session for the screen at the front of the room: where to join, the
// hall seen from the front, so the room sees itself, how many are lost, and
// the questions most people want answered, in type the back row can read.
// Nobody presses anything here, so it has no forms.
const TOP = 3;

const raw = Astro.params.code ?? "";
const code = normaliseCode(raw);
const session = isCode(code) ? findSession(code) : undefined;
if (!session) Astro.response.status = 404;

// Popular order puts the open questions first, so the top of it is what is still to answer
const all = session ? listQuestions(session, Astro.locals.person, "popular").filter((q) => q.state !== "hidden") : [];
const top = all.filter((q) => q.state === "open").slice(0, TOP);

// the QR code opens the session page itself, so a scan skips typing the code
const address = session ? new URL(`/s/${session.code}`, Astro.url).href : "";
const qr = session ? renderSVG(address, { border: 0, ecc: "M", blackColor: "#121212", whiteColor: "#ffffff" }) : "";

// the hall as it is now; this screen is not a person, so it is not in it
const inRoom = session ? [...people(session.id)] : [];
const room = { here: inRoom.length, hands: session ? handsUp(session.id, inRoom) : [], mine: null, recent: [] };
---

{
  session ? (
    <Layout title={`${session.title} · Hands Up`} account={false} footer={false}>
      <div class="present" data-live={`/s/${session.code}/events?screen`}>
        <main id="main" class="stage">
          <div class="stage-top">
            <h1>{session.title}</h1>
            <div class="stage-context">
              <p class="count-label">
                <span data-here hidden />
                <span data-count>{howMany(all.length)}</span>
              </p>
            </div>
          </div>

          <div class="present-room">
            <div class="stage-hall">
              <div class="stage-message">
                <p class="stage-lost" aria-live="polite" data-lost data-room={JSON.stringify(room)}>
                  {lostLabel(room.hands.length, room.here)}
                </p>
                <GoingOver age={goingOverAge(session.id)} />
                <p class="stage-silence" data-silence hidden={room.hands.length > 0}>
                  {SILENCE_SHORT}
                </p>
                {/* The connection qualifies the count beside it (src/scripts/live.ts). */}
                <p class="live present-live" role="status" data-live-status hidden />
              </div>
              {/* drawn by src/scripts/hall.ts from the front of the room; the sentence beside it says the same in words */}
              <div class="hall-view" data-hall data-view="front" aria-hidden="true" />
            </div>

            <aside class="rail" aria-label="How to join">
              <div class="rail-step rail-address">
                <p>Scan, or go to</p>
                <p class="rail-where">{Astro.url.host}</p>
              </div>
              <div class="qr" role="img" aria-label={`QR code for ${address}`} set:html={qr} />
              {/* for someone who opened this page on their own device and wants to ask */}
              <a class="rail-ask" href={`/s/${session.code}/questions`}>
                Ask from this device <Icon name="arrow" size={18} />
              </a>
              <div class="rail-step rail-code">
                <p>and type the code</p>
                <p class="big-code">{session.code}</p>
              </div>
            </aside>
          </div>

          {/* the page's script (src/scripts/live.ts) redraws what is in here after every change */}
          <div class="stage-list" data-board data-refresh>
            {top.length === 0 ? (
              <p class="stage-empty">
                {all.length === 0
                  ? "No questions yet. Join with the code and ask the first one."
                  : "Every question so far is answered. Join with the code and ask the next one."}
              </p>
            ) : (
              <ol aria-label="Top questions" class="top">
                {top.map((q) => (
                  <li id={`q-${q.id}`}>
                    <p class="body">{q.body}</p>
                    <p class="votes">
                      <Icon name="hand" size={34} />
                      <span class="n">{q.votes}</span>
                      {" "}
                      <span class="unseen">{q.votes === 1 ? "vote" : "votes"}</span>
                    </p>
                  </li>
                ))}
              </ol>
            )}
          </div>

          <div class="present-foot">
            <a class="brand" href="/">
              <span class="brand-mark">
                <Icon name="hand" />
              </span>
              Hands Up
            </a>
            <p class="stage-foot">
              <Icon name="lock" size={18} /> Anonymous: no one, the host included, is shown who asked or whose hand is up.
            </p>
            {/* for someone who opened this page on their own device and wants to ask */}
            <a class="rail-ask" href={`/s/${session.code}`}>
              Ask from this device <Icon name="arrow" size={18} />
            </a>
          </div>
        </main>
      </div>
      <script>
        import "../../../scripts/live.ts";
        import "../../../scripts/hand.ts";
        void import("../../../scripts/hall.ts");
      </script>
    </Layout>
  ) : (
    <Layout title="No such session · Hands Up">
      <SlimHeader />
      <main id="main" class="wrap lost">
        <div class="card panel">
          <h1>No session with the code {code}</h1>
          <p>Check the code on the screen at the front of the room, and try again.</p>
          <JoinForm value={raw} />
        </div>
      </main>
    </Layout>
  )
}
