---
import Card from "../../../components/Card.astro";
import ReportedNotice from "../../../components/ReportedNotice.astro";
import GoingOver from "../../../components/GoingOver.astro";
import Icon from "../../../components/Icon.astro";
import JoinForm from "../../../components/JoinForm.astro";
import SessionBand from "../../../components/SessionBand.astro";
import SessionTabs from "../../../components/SessionTabs.astro";
import SlimHeader from "../../../components/SlimHeader.astro";
import TutorialTimer from "../../../components/TutorialTimer.astro";
import Layout from "../../../layouts/Layout.astro";
import { mark, report, unreport, vote } from "../../../lib/actions.ts";
import { authLink } from "../../../lib/auth.ts";
import { accountRefusal } from "../../../lib/abuse.ts";
import {
  askQuestion,
  checkQuestion,
  findSession,
  isCode,
  isHost,
  length,
  listQuestions,
  MAX_QUESTION,
  normaliseCode,
  type Sort,
} from "../../../lib/board.ts";
import { howMany, lostLabel, refusal, SILENCE_SHORT, tooFast } from "../../../lib/words.ts";
import { goingOverAge } from "../../../lib/going-over.ts";
import { guideDone } from "../../../lib/guide.ts";
import { people } from "../../../lib/live.ts";
import { handsUp } from "../../../lib/room.ts";
import { tutorialFor } from "../../../lib/tutorial.ts";

// The questions, the second part of a session: asking, "Me too", and the
// host's buttons. The hall, at /s/CODE, is the first.
const raw = Astro.params.code ?? "";
const code = normaliseCode(raw);
if (Astro.request.method === "GET" && code !== raw && isCode(code)) {
  return Astro.redirect(`/s/${code}/questions${Astro.url.search}`, 301);
}
const session = isCode(code) ? findSession(code) : undefined;
const tutorial = session ? tutorialFor(session.id) : undefined;
const sort: Sort = Astro.url.searchParams.get("sort") === "recent" ? "recent" : "popular";
const base = `/s/${code}/questions`;
const here = sort === "recent" ? `${base}?sort=recent` : base;
const person = Astro.locals.person;
const signedIn = Astro.locals.account !== null;
const returnTo = Astro.url.pathname + Astro.url.search;
const log = Astro.locals.log;

// Asking and voting post back to this page: plain forms, no script needed.
// A refused question comes back with the text kept and the reason.
let draft = "";
let problem: string | undefined;
// a refused press on a card comes back saying why
let refused = "";
const signedOutPost = session && Astro.request.method === "POST" && !signedIn;
if (signedOutPost) {
  Astro.response.status = 401;
  log("refused", { session: session.code, reason: "signed-out" });
} else if (session && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = form.get("intent");
  if (intent === "ask") {
    draft = String(form.get("body") ?? "").trim();
    problem = checkQuestion(draft);
    if (!problem) {
      const limited = accountRefusal(person, "ask", log, session.code);
      if (limited) {
        Astro.response.status = limited.status;
        Astro.response.headers.set("Retry-After", String(limited.retryAfter));
        problem = tooFast(limited.retryAfter);
      } else {
        const id = askQuestion(session, person, draft);
        log("question_asked", { session: session.code, question: id });
        return Astro.redirect(`${here}${sort === "recent" ? "&" : "?"}posted=${id}`, 303);
      }
    } else {
      Astro.response.status = 422;
      const reason = draft.length === 0 ? "empty" : "too-long";
      log("refused", { action: "ask", session: session.code, reason, length: length(draft) });
    }
  } else if (intent === "vote" || intent === "state" || intent === "report" || intent === "unreport") {
    const action = intent === "vote" ? vote : intent === "report" ? report : intent === "unreport" ? unreport : mark;
    const done = action(session, person, form, log);
    if (done.ok) return Astro.redirect(`${here}#q-${done.question}`, 303);
    Astro.response.status = done.status;
    if (done.retryAfter) Astro.response.headers.set("Retry-After", String(done.retryAfter));
    refused = done.status === 429 ? tooFast(done.retryAfter) : refusal(intent, done.status);
  } else {
    Astro.response.status = 400;
    refused = refusal("", 400);
    log("refused", { session: session.code, reason: "no-such-intent" });
  }
}
if (!session) Astro.response.status = 404;

const list = session ? listQuestions(session, signedIn ? person : "", sort) : [];
const hosting = signedIn && session !== undefined && isHost(session, person);
const guideComplete = guideDone({ account: Astro.locals.account, cookies: Astro.cookies }, hosting ? "host" : "student");
const listed = list.filter((q) => q.state !== "hidden").length;
// Only confirm a question this person can still find in this session's list.
const posted = Astro.request.method === "GET"
  ? list.find((q) => q.id === Number(Astro.url.searchParams.get("posted")) && q.yours)
  : undefined;
const inRoom = session && hosting ? [...people(session.id)] : [];
const room = {
  here: inRoom.length,
  hands: session && hosting ? handsUp(session.id, inRoom) : [],
  mine: null,
  startedAt: session?.createdAt.getTime(),
};
---

{
  session ? (
    <Layout title={`${tutorial ? "Questions for later" : "Questions"} · ${session.title} · Hands Up`}>
      <SessionBand code={session.code} title={session.title} hosting={hosting} guideComplete={guideComplete}>
        <SessionTabs code={session.code} at="questions" count={listed} mode={tutorial ? "tutorial" : "lecture"} />
      </SessionBand>

      <main id="main" class="wrap question-layout" data-live={`/s/${session.code}/events`}>
        {tutorial && (
          <section class="tutorial-questions" aria-labelledby="later-title">
            <h2 id="later-title">Questions for the next lecture</h2>
            <p>Keep unresolved questions for the next lecture. They stay on this board after class; they are not copied to another session.</p>
            <p class="hint">No author names are shown. Wording or timing may identify you in this small room. Leave out names and identifying details. <a href="/privacy">Privacy and rules</a></p>
            {Astro.url.searchParams.get("from") === "timeline" && <p class="hint">Tutorials do not show a personal help history. Keep the questions you want to revisit here.</p>}
            <TutorialTimer state={tutorial} compact />
          </section>
        )}
        {refused && (
          <p class="alert" role="alert">
            {refused}
          </p>
        )}
        {signedIn ? (
          <form method="post" class="card ask" data-ask>
            <input type="hidden" name="intent" value="ask" />
            <label for="body">Your question</label>
            <textarea id="body" name="body" rows="2" maxlength={MAX_QUESTION} required placeholder="What do you want to ask?" aria-describedby="body-help">{draft}</textarea>
            {problem && (
              <p class="alert" role="alert">
                {problem}
              </p>
            )}
            <div class="ask-row">
              <p class="hint" id="body-help">
                <Icon name="lock" size={14} /> {tutorial ? "No author names on this board" : "Anonymous, even to the host"}
              </p>
              <button class="button tomato" type="submit">
                Ask
              </button>
            </div>
          </form>
        ) : (
          <section class="card ask auth-prompt">
            {signedOutPost && (
              <p class="alert" role="alert">Sign in to do that. <a href={authLink("signin", returnTo)}>Sign in</a></p>
            )}
            <a class="button tomato" href={authLink("signin", returnTo)}>Sign in to ask a question</a>
            <p class="hint">
              No account? <a href={authLink("signup", returnTo)}>Create one</a>: just a username and password.
            </p>
          </section>
        )}

        <p class="question-posted" role="status" data-question-posted hidden={!posted}>
          {posted && (
            <>
              Question posted. <a href={`#q-${posted.id}`}>View your question</a>{" "}
              <a href={`/s/${session.code}${tutorial ? "" : "#hall"}`}>{tutorial ? "Back to the tutorial room" : "Back to the hall"}</a>
            </>
          )}
        </p>

        {hosting && !tutorial && (
          <div class="question-room">
            <p aria-live="polite" data-lost data-host data-room={JSON.stringify(room)}>
              {room.here === 0 ? "Waiting for students to join." : lostLabel(room.hands.length, room.here)}
            </p>
            <a href={`/s/${session.code}#hall`}>Going over it is on the hall</a>
            <p class="hint question-silence" data-silence hidden={room.hands.length > 0 || room.here === 0}>
              {SILENCE_SHORT}
            </p>
          </div>
        )}

        <div class="bar">
          <nav class="tabs" aria-label="Order">
            <a href={base} aria-current={sort === "popular" ? "page" : undefined}>
              Popular
            </a>
            <a href={`${base}?sort=recent`} aria-current={sort === "recent" ? "page" : undefined}>
              Recent
            </a>
          </nav>
          <div class="bar-end">
            {/* shown by the page's script once its stream is open */}
            <p class="live" role="status" data-live-status hidden />
            {!tutorial && <p class="count-label" data-here hidden />}
            <p class="count-label" data-count>{howMany(listed)}</p>
          </div>
        </div>

        {!tutorial && <GoingOver age={goingOverAge(session.id)} />}
        {/* the page's script (src/scripts/live.ts) keeps what is in here up to date */}
        <div data-board data-sort={sort}>
          <ReportedNotice list={list} hosting={hosting} link={(id) => `#q-${id}`} />
          {/* shown while the list is empty; the script hides it when the first question arrives */}
          <p class="card empty" data-empty hidden={list.length > 0}>
            <Icon name="hand" size={22} /> <span>No questions yet.</span>{" "}
            <a href={signedIn ? "#body" : authLink("signin", returnTo)}>Be the first to ask.</a>
          </p>
          <ol aria-label="Questions" class="questions">
            {list.map((q) => (
              <Card q={q} hosting={hosting} reportable={session.host !== null} />
            ))}
          </ol>
        </div>
        {/* an empty card for the script to copy when a question arrives while the page is open */}
        <template data-card>
          <Card
            q={{ id: 0, body: "", createdAt: new Date(0), votes: 0, yours: false, voted: false, reported: false, reportedAt: null, reports: 0, state: "open" }}
            hosting={hosting}
            reportable={session.host !== null}
          />
        </template>
        {!hosting && (
          <p class="foot session-foot">
            <a href={`/s/${session.code}/present`}>Projector page</a>{!guideComplete && <> <span>For the screen at the front.</span></>}
          </p>
        )}
      </main>
      <script>
        import "../../../scripts/live.ts";
        import "../../../scripts/hand.ts";
      </script>
    </Layout>
  ) : (
    <Layout title="No such session · Hands Up">
      <SlimHeader />
      <main id="main" class="wrap lost">
        <div class="card panel">
          <h1>No session with the code {code}</h1>
          <p>Check the code on the screen at the front of the room, and try again.</p>
          <JoinForm value={raw} />
        </div>
      </main>
    </Layout>
  )
}

<style>
  .tutorial-questions { display: grid; gap: var(--space-4); }
  .tutorial-questions h2 { margin: 0; font: var(--weight-bold) var(--text-2xl) / var(--leading-heading) var(--display); }
  .tutorial-questions p { margin: 0; max-width: 68ch; }
  .tutorial-questions .hint { display: block; }
  .tutorial-questions .hint a { display: inline-flex; align-items: center; min-height: var(--target-min); }
</style>
