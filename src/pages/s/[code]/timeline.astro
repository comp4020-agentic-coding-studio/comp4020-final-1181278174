---
import Icon from "../../../components/Icon.astro";
import JoinForm from "../../../components/JoinForm.astro";
import SessionBand from "../../../components/SessionBand.astro";
import SessionTabs from "../../../components/SessionTabs.astro";
import SlimHeader from "../../../components/SlimHeader.astro";
import Layout from "../../../layouts/Layout.astro";
import { findSession, isCode, isHost, listQuestions, normaliseCode } from "../../../lib/board.ts";
import { classesOf } from "../../../lib/classes.ts";
import { goingOversOf } from "../../../lib/going-over.ts";
import { people } from "../../../lib/live.ts";
import { recordingStart, timelineMark } from "../../../lib/actions.ts";
import { authLink } from "../../../lib/auth.ts";
import type { Refused } from "../../../lib/abuse.ts";
import { intoRecording, type Minute, marksOf, MAX_MARK, partAt, sittings } from "../../../lib/record.ts";
import { clock, day, tooFast } from "../../../lib/words.ts";
import { tutorialFor } from "../../../lib/tutorial.ts";

// The hall's record: how many hands were up in each minute, out of how many
// people, for the last few sittings. Counts only, so anyone with the code may
// read it. It is still here the next day, and after a restart.
const raw = Astro.params.code ?? "";
const code = normaliseCode(raw);
if (Astro.request.method === "GET" && code !== raw && isCode(code)) {
  return Astro.redirect(`/s/${code}/timeline${Astro.url.search}`, 301);
}

let session = isCode(code) ? findSession(code) : undefined;
const person = Astro.locals.person;
const signedIn = Astro.locals.account !== null;
const returnTo = Astro.url.pathname + Astro.url.search;
const log = Astro.locals.log;
if (!session) Astro.response.status = 404;
if (session && tutorialFor(session.id)) {
  if (Astro.request.method === "POST") {
    const status = signedIn && isHost(session, person) ? 422 : 403;
    log("refused", { session: session.code, action: "tutorial-timeline", reason: "no-tutorial-timeline" });
    return new Response("Tutorials use Questions for later. Open /s/" + session.code + "/questions to revisit this class's questions.", { status, headers: { "Content-Type": "text/plain; charset=utf-8" } });
  }
  return Astro.redirect(`/s/${session.code}/questions?from=timeline`, 303);
}

let shown = session ? sittings(session.id, people(session.id).size) : [];
let refused = "";
let markValue = "";
let recordingValue: string | undefined;

// The host's two forms: a mark now, and when the recording started. Anyone else is refused.
const signedOutPost = session && Astro.request.method === "POST" && !signedIn;
if (session && signedOutPost) {
  Astro.response.status = 401;
  log("refused", { session: session.code, reason: "signed-out" });
} else if (session && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = form.get("intent");
  if (intent === "timeline_mark") markValue = String(form.get("label") ?? "");
  if (intent === "recording") recordingValue = String(form.get("at") ?? "");
  if (intent !== "timeline_mark" && intent !== "recording") log("refused", { session: session.code, reason: "no-such-intent" });
  const done =
    intent === "timeline_mark"
      ? timelineMark(session, person, form, log)
      : intent === "recording"
        ? // a time of day, on the day of the newest sitting
          recordingStart(session, person, form, log, shown[0]?.from ?? new Date())
        : ({ ok: false, status: 422 } as Refused);
  if (done.ok) return Astro.redirect(`/s/${session.code}/timeline`, 303);
  Astro.response.status = done.status;
  if (done.retryAfter) Astro.response.headers.set("Retry-After", String(done.retryAfter));
  refused = done.status === 429 ? tooFast(done.retryAfter)
    : done.status === 403 ? "Only the host can save a mark or recording time."
    : intent === "timeline_mark" ? `Use at most ${MAX_MARK} characters for a mark.`
    : intent === "recording" ? "Enter the recording start as a time, such as 14:02."
    : "Choose a mark or a recording time to save.";
  session = findSession(session.code);
  shown = session ? sittings(session.id, people(session.id).size) : [];
}

const hosting = signedIn && session !== undefined && isHost(session, person);
const listed = session ? listQuestions(session, signedIn ? person : "", "popular").filter((q) => q.state !== "hidden").length : 0;
const all = session ? marksOf(session.id) : [];
const goingOvers = session ? goingOversOf(session.id) : [];
// when each class started and ended, kept apart from the numbered parts
const lessons = (session ? classesOf(session.id) : []).flatMap((c) => [
  { at: c.startedAt, label: "Class started" },
  ...(c.endedAt ? [{ at: c.endedAt, label: "Class ended" }] : []),
]);
const inMinute = (at: Date, m: Minute): boolean => at >= m.at && at.getTime() < m.at.getTime() + 60_000;
const recordingAt = session?.recordingAt ?? null;
/** What a minute says in words: when, how many lost, in which part, how far into the recording. */
const about = (m: Minute): string[] => {
  const into = intoRecording(recordingAt, m.at);
  return [
    `${m.lost} of ${m.here} said they were lost`,
    ...lessons.filter((event) => inMinute(event.at, m)).map((event) => event.label),
    partAt(all, m.at)?.label ?? "",
    goingOvers.some((event) => inMinute(event.at, m)) ? "Going over it" : "",
    into === undefined ? "" : `${into} min into the recording`,
  ].filter(Boolean);
};

/** The minutes most people were lost, most first; the earlier one when two tie. */
const busiest = (minutes: Minute[]): Minute[] =>
  minutes
    .filter((m) => m.lost > 0)
    .sort((a, b) => b.lost - a.lost || b.lost / b.here - a.lost / a.here || a.at.getTime() - b.at.getTime())
    .slice(0, 3);

---

{
  session ? (
    <Layout title={`When the room was lost · ${session.title} · Hands Up`}>
      <SessionBand code={session.code} title={session.title} hosting={hosting}>
        <SessionTabs code={session.code} at="timeline" count={listed} />
      </SessionBand>

      <main id="main" class:list={["wrap timeline", { "timeline-with-host": hosting }]} data-live={`/s/${session.code}/events`}>
        <section class="card timeline-head" aria-labelledby="timeline-title">
          {signedOutPost && (
            <p class="alert" role="alert">Sign in to do that. <a href={authLink("signin", returnTo)}>Sign in</a></p>
          )}
          <div class="timeline-title">
            <h2 id="timeline-title">When the room was lost</h2>
            <span class="live" data-live-status hidden />
            {/* shown by src/scripts/float.ts once there is a sitting to pop out */}
            <div class="pop-control" hidden>
              <button class="button pop" type="button" data-pop="timeline" aria-describedby="timeline-pop-note" hidden>
                <Icon name="pop" size={16} /> Pop out
              </button>
              <p class="hint pop-note" id="timeline-pop-note">Keep this tab open; you can switch to your slides.</p>
            </div>
          </div>
          <p class="hint">
            <Icon name="lock" size={14} /> Hands up in each minute, out of everyone here then. No one is shown whose.
          </p>
        </section>

        <div data-sittings>
        {shown.length === 0 && (
          <p class="card empty">
            <Icon name="hand" size={22} /> Nobody has had this session open yet.
          </p>
        )}

        {shown.map((s) => {
          const scale = Math.max(1, s.most);
          const top = busiest(s.minutes);
          const id = `sitting-${s.from.getTime()}`;
          const lanes: number[] = [];
          const events = [
            ...all.filter((mk) => mk.at >= s.from && mk.at < s.to).map((mk, i) => ({ ...mk, kind: "part" as const, number: i + 1 })),
            ...goingOvers.filter((event) => event.at >= s.from && event.at < s.to).map((event) => ({ ...event, kind: "going" as const })),
            ...lessons.filter((event) => event.at >= s.from && event.at < s.to).map((event) => ({ ...event, kind: "class" as const })),
          ].sort((a, b) => a.at.getTime() - b.at.getTime()).map((mk) => {
            const left = ((mk.at.getTime() - s.from.getTime()) / (s.to.getTime() - s.from.getTime())) * 100;
            // At phone width, nearby badges need separate rows. Labels live in the legend.
            let lane = lanes.findIndex((previous) => left - previous >= 18);
            if (lane < 0) lane = lanes.length;
            lanes[lane] = left;
            return { ...mk, left, lane };
          });
          const marked = events.filter((event) => event.kind === "part");
          const going = events.filter((event) => event.kind === "going");
          const lesson = events.filter((event) => event.kind === "class");
          const middle = Math.floor(s.minutes.length / 2);
          // times along a zoomed axis: every 10 minutes on a long sitting, every 5 on a shorter one
          const step = s.minutes.length > 60 ? 10 : 5;
          return (
            <section class="card sitting" aria-labelledby={id}>
              <h3 id={id}>
                {day(s.from)},{" "}<time datetime={s.from.toISOString()}>{clock(s.from)}</time>{" to "}
                <time datetime={s.to.toISOString()}>{clock(s.to)}</time>
              </h3>
              <p class="hint">
                {s.most} here at most{" · "}
                {s.mostLost === 0 ? "nobody said they were lost" : `at most ${s.mostLost} said they were lost in a minute`}
              </p>
              <p class="hint">Each bar is one minute. Height: how many said they were lost.</p>
              {/* Every minute is also written below, so screen readers can skip the drawing. */}
              <div class="chart" aria-hidden="true" style={`--mark-rows: ${lanes.length}`} data-chart data-step={step}>
                <div class="chart-scale">
                  <span style="bottom: 100%">{scale}</span>
                  {scale > 1 && <span style={`bottom: ${Math.floor(scale / 2) / scale * 100}%`}>{Math.floor(scale / 2)}</span>}
                  <span style="bottom: 0">0</span>
                </div>
                {/* zoomed in, only this part grows: the scale and the page stay put */}
                <div class="chart-view" data-chart-view>
                  <div class="chart-track">
                    <div class="chart-plot">
                      {scale > 1 && <span class="chart-guide" style={`bottom: ${Math.floor(scale / 2) / scale * 100}%`} />}
                      <div class="chart-bars" style={`gap: ${s.minutes.length > 120 ? 0 : s.minutes.length > 60 ? 1 : 2}px`}>
                      {s.minutes.map((m) => (
                        <span
                          class={m.lost > 0 && m.lost === s.mostLost ? "chart-bar most" : "chart-bar"}
                          style={`height: ${(m.lost / scale) * 100}%`}
                          title={`${clock(m.at)}: ${about(m).join(", ")}`}
                        />
                      ))}
                      </div>
                      {marked.map((mk) => (
                        <span class="chart-mark" title={`Mark ${mk.number}: ${mk.label}`} style={`left: clamp(1rem, ${mk.left}%, calc(100% - 1rem)); --lane: ${mk.lane}`}>
                          <span>{mk.number}</span>
                        </span>
                      ))}
                      {going.map((event) => (
                        <span class="chart-mark going-mark" title="Going over it" style={`left: clamp(1rem, ${event.left}%, calc(100% - 1rem)); --lane: ${event.lane}`}>
                          <span class="going-symbol">◇</span>
                        </span>
                      ))}
                      {lesson.map((event) => (
                        <span class="chart-mark class-mark" title={event.label} style={`left: clamp(1rem, ${event.left}%, calc(100% - 1rem)); --lane: ${event.lane}`}>
                          <span class="class-symbol">{event.label === "Class started" ? "▸" : "■"}</span>
                        </span>
                      ))}
                    </div>
                    <div class="chart-ticks">
                      <span class="chart-start">{clock(s.from)}</span>
                      {s.minutes.length >= 4 && <span class="chart-middle" style={`left: ${middle / s.minutes.length * 100}%`}>{clock(s.minutes[middle].at)}</span>}
                      {/* more times along the axis, shown once the chart is zoomed in far enough to fit them */}
                      {s.minutes.map((m, i) => i > 0 && i < s.minutes.length - 1 && (
                        <span class={m.at.getMinutes() % step === 0 ? "chart-tick-more" : "chart-tick-fine"} style={`left: ${(i + 0.5) / s.minutes.length * 100}%`}>{clock(m.at)}</span>
                      ))}
                      <span class="chart-end">{clock(s.to)}</span>
                    </div>
                  </div>
                </div>
              </div>
              {/* The sliding window: the whole sitting stays drawn small here, and the
                  box shows which part the chart above is zoomed in on. Shown by
                  src/scripts/chart-zoom.ts; without it the chart fits the width. */}
              <div class="chart-zoom" data-chart-zoom hidden>
                <div class="chart-overview" data-chart-overview>
                  <div class="chart-overview-bars" aria-hidden="true">
                    {s.minutes.map((m) => <span class={m.lost > 0 && m.lost === s.mostLost ? "most" : undefined} style={`height: ${(m.lost / scale) * 100}%`} />)}
                  </div>
                  <span class="chart-window" data-chart-window role="slider" tabindex="0" aria-label="The part of the sitting the chart shows" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext={`${clock(s.from)} to ${clock(s.to)}`}>
                    <span class="chart-window-edge" data-edge="start" />
                    <span class="chart-window-edge" data-edge="end" />
                  </span>
                </div>
                <div class="chart-zoom-buttons">
                  <button class="chart-zoom-button" type="button" data-zoom="out" aria-label="Zoom out on time" title="Zoom out">−</button>
                  <button class="chart-zoom-button" type="button" data-zoom="in" aria-label="Zoom in on time" title="Zoom in (or Ctrl + scroll on the chart)">+</button>
                  <button class="chart-zoom-button chart-zoom-fit" type="button" data-zoom="fit" aria-label="Show the whole sitting" title="Show the whole sitting">Fit</button>
                </div>
              </div>
              {marked.length > 0 && (
                <ol class="chart-legend" aria-label="Chart marks">
                  {marked.map((mk) => (
                    <li value={mk.number}>
                      <span class="mark-number">{mk.number}</span>{" "}
                      <time datetime={mk.at.toISOString()}>{clock(mk.at)}</time>{" "}
                      <span>{mk.label}</span>
                    </li>
                  ))}
                </ol>
              )}
              {lesson.length > 0 && (
                <ul class="chart-legend" aria-label="Class">
                  {lesson.map((event) => (
                    <li>
                      <span class="mark-number class-symbol" aria-hidden="true">{event.label === "Class started" ? "▸" : "■"}</span>{" "}
                      <time datetime={event.at.toISOString()}>{clock(event.at)}</time>{" "}
                      <span>{event.label}</span>
                    </li>
                  ))}
                </ul>
              )}
              {going.length > 0 && (
                <ul class="chart-legend" aria-label="Going over it">
                  {going.map((event) => (
                    <li>
                      <span class="mark-number going-symbol" aria-hidden="true">◇</span>{" "}
                      <time datetime={event.at.toISOString()}>{clock(event.at)}</time>{" "}
                      <span>Going over it</span>
                    </li>
                  ))}
                </ul>
              )}
              {top.length > 0 && (
                <>
                  <h4>The minutes most people were lost</h4>
                  <ol class="busiest" aria-label="The minutes most people were lost">
                    {top.map((m) => (
                      <li>
                        <strong><time datetime={m.at.toISOString()}>{clock(m.at)}</time></strong>{" "}
                        {about(m).map((part) => (
                          <>
                            <span>{part}</span>{" "}
                          </>
                        ))}
                      </li>
                    ))}
                  </ol>
                </>
              )}
              <details id={`${id}-minutes`} class="minute-details">
                <summary id={`${id}-summary`}>Every minute ({s.minutes.length})</summary>
                <ol class="minute-list" aria-label="Every minute">
                  {s.minutes.map((m) => (
                    <li>
                      <strong><time datetime={m.at.toISOString()}>{clock(m.at)}</time></strong>{" "}
                      {about(m).map((part) => <><span>{part}</span>{" "}</>)}
                    </li>
                  ))}
                </ol>
              </details>
            </section>
          );
        })}
        </div>

        <div class="timeline-tools">
        <p data-timeline-status role="status" hidden={!refused}>{refused}</p>

        {hosting && (
          <section class="card host-panel" aria-labelledby="host-title">
            <h3 id="host-title">For the host</h3>
            <form method="post" class="host-form" data-timeline-form>
              <input type="hidden" name="intent" value="recording" />
              <label for="recording-at">The recording started at</label>
              <div class="host-row">
                <input id="recording-at" name="at" type="time" required value={recordingValue ?? (recordingAt ? clock(recordingAt) : "")} aria-describedby="recording-help" />
                <button class="button" type="submit">
                  Save
                </button>
              </div>
              <p class="hint" id="recording-help">
                Then every minute also says how far into the Echo360 recording it is. A link that starts there is made in Echo360 by the
                video's owner.
              </p>
            </form>
            <form method="post" class="host-form" data-timeline-form>
              <input type="hidden" name="intent" value="timeline_mark" />
              <label for="mark-label">A mark now, where a new part starts</label>
              <div class="host-row">
                <input id="mark-label" name="label" type="text" maxlength={MAX_MARK} value={markValue} placeholder={`Part ${all.length + 1}`} />
                <button class="button ink" type="submit">
                  Mark
                </button>
              </div>
            </form>
              <ul class="marks" aria-label="Marks" data-marks hidden={all.length === 0}>
                {all.map((mk) => (
                  <li>
                    <span>{mk.label}</span> <span class="hint">{clock(mk.at)}</span>
                  </li>
                ))}
              </ul>
          </section>
        )}

        </div>

        <p class="foot session-foot">
          <a href={`/s/${session.code}`}>Back to the hall</a>{" "}
          <span>{hosting ? "You teach: you have no hand here." : signedIn ? "Raise your hand there, no words needed." : "Sign in to raise a hand."}</span>
        </p>
      </main>
      <script>
        import "../../../scripts/timeline.ts";
        import "../../../scripts/chart-zoom.ts";
        import "../../../scripts/float.ts";
      </script>
    </Layout>
  ) : (
    <Layout title="No such session · Hands Up">
      <SlimHeader />
      <main id="main" class="wrap lost">
        <div class="card panel">
          <h1>No session with the code {code}</h1>
          <p>Check the code on the screen at the front of the room, and try again.</p>
          <JoinForm value={raw} />
        </div>
      </main>
    </Layout>
  )
}
