---
import AccountForm from "../components/AccountForm.astro";
import SlimHeader from "../components/SlimHeader.astro";
import Layout from "../layouts/Layout.astro";
import { verifyPassword } from "../lib/accounts.ts";
import { completeSignIn, returnPath } from "../lib/auth.ts";

let username = "";
let problem: string | undefined;
let returnTo = returnPath(Astro.url.searchParams.get("return"));
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  username = String(form.get("username") ?? "");
  returnTo = returnPath(form.get("return") ?? returnTo);
  // Fly's proxy gives the visitor's address in Fly-Client-IP; it is used to count wrong passwords, in memory only
  let network = Astro.request.headers.get("fly-client-ip") ?? "";
  if (!network) {
    try {
      network = Astro.clientAddress;
    } catch {
      network = "";
    }
  }
  const result = await verifyPassword(username, String(form.get("password") ?? ""), { browser: Astro.locals.browser, network });
  // the password may have changed while it was being checked: then it is the wrong one
  if (result.ok && completeSignIn(result.account.id, Astro.cookies, Astro.url, result.verifiedHash)) {
    Astro.locals.log("signed_in");
    return Astro.redirect(returnTo, 303);
  }
  Astro.response.status = 422;
  problem = result.ok ? "The username or password is wrong." : result.message;
  Astro.locals.log("refused", { action: "signin", reason: result.ok ? "password-changed" : result.reason });
}
---

<Layout title="Sign in · Hands Up">
  <SlimHeader />
  <main id="main" class="wrap account-page">
    <AccountForm username={username} returnTo={returnTo} problem={problem} />
  </main>
</Layout>
